{
  "name": "smart-group",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox extension that automatically groups tabs by website or category.",
  "scripts": {
    "start": "web-ext run --source-dir src",
    "lint": "web-ext lint --source-dir src",
    "build": "web-ext build --source-dir src --artifacts-dir dist --overwrite-dest",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  }
}
