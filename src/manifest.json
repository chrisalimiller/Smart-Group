{
  "manifest_version": 3,
  "name": "Smart Group",
  "version": "0.1.0",
  "description": "Automatically groups your tabs by website or by category, using Firefox's built-in tab groups.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "compat.js",
      "categories.js",
      "grouping.js",
      "titles.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smart-group@chrisalimiller",
      "strict_min_version": "139.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
